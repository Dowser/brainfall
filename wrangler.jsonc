// Cloudflare Workers: serves the static Vite build (dist/) – no Worker script needed.
// _headers in public/ is copied to dist/ and applied by Workers static assets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brainfall",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
